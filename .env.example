# Host artifact directories mounted read-only by Compose. Use absolute paths.
GTE_MODEL_HOST_PATH=/absolute/path/to/models/gte-modernbert-base
BGE_RERANKER_HOST_PATH=/absolute/path/to/models/bge-reranker-v2-m3-onnx
GRANITE_MODEL_HOST_PATH=/absolute/path/to/merged-granite-4.1-3b-query-rewrite
SEGMENTATION_MODEL_HOST_PATH=/absolute/path/to/all-MiniLM-L6-v2

# Native (non-Compose) runtime paths. Compose overrides these with mount targets.
ONNX_EMBEDDING_MODEL_PATH=/absolute/path/to/models/gte-modernbert-base
ONNX_RERANKER_MODEL_PATH=/absolute/path/to/models/bge-reranker-v2-m3-onnx
GRANITE_QUERY_REWRITE_MODEL_PATH=/absolute/path/to/merged-granite-4.1-3b-query-rewrite
SEGMENTATION_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEGMENTATION_MODEL_PATH=/absolute/path/to/all-MiniLM-L6-v2
SEGMENTATION_EMBEDDING_DEVICE=cpu

# External SGLang services. They are not started by this Compose project.
# Private Modal Servers accept the combined Proxy Token as TOKEN_ID.TOKEN_SECRET.
# Do not configure an SGLang-owned --api-key; SGLang 0.5.18 logs server arguments.
QUERY_REWRITE_ENGINE=sglang
SGLANG_QUERY_REWRITE_BASE_URL=https://granite-sglang.example/v1
SGLANG_QUERY_REWRITE_API_KEY=
SGLANG_QUERY_REWRITE_MODEL=merged-granite-4.1-3b-query-rewrite
QWEN_SGLANG_BASE_URL=https://qwen-sglang.example/v1
QWEN_SGLANG_API_KEY=
QWEN_SGLANG_SERVED_MODEL=qwen3-4b-awq
QWEN_MODEL_PATH=qwen3-4b-awq

# Local ONNX execution. The Docker profile is fail-closed CUDA/FP16.
ONNX_EMBEDDING_EXECUTION_PROVIDER=CUDAExecutionProvider
ONNX_EMBEDDING_CUDA_DEVICE_ID=0
ONNX_EMBEDDING_DISABLE_CPU_FALLBACK=true
ONNX_RERANKER_EXECUTION_PROVIDER=CUDAExecutionProvider
ONNX_RERANKER_CUDA_DEVICE_ID=0
ONNX_RERANKER_DISABLE_CPU_FALLBACK=true

# Development API settings.
WEAVIATE_URL=http://localhost:8080
# auto: API key selects Weaviate Cloud; no key selects the custom connection.
# cloud: require the Cloud helper. custom: use the explicit REST/gRPC settings,
# optionally with API-key authentication (required for the secure Mac tunnel).
WEAVIATE_CONNECTION_MODE=auto
WEAVIATE_API_KEY=
WEAVIATE_GRPC_PORT=50051
WEAVIATE_GRPC_SECURE=false
CORS_ALLOWED_ORIGINS=*
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=26214400
UPLOAD_READ_CHUNK_BYTES=65536
TASK_MAX_COMPLETED_RECORDS=10000

# Local client settings for the private Modal FastAPI deployment.
# The separate ID/secret authenticate callers of the FastAPI Modal Server.
RAG_API_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Default user used by ./rag ask. Change this after loading your own data.
RAG_USER_ID=e2e_20260901_0cd6147d7fd3

# Operational Modal capacity requests used by ./rag up. These never alter model
# identity, precision, quantization, prompts, context, or inference behavior.
MODAL_SGLANG_GPU=L40S
QWEN_MODAL_SGLANG_GPU=H100
MODAL_RAG_GPU=L40S
